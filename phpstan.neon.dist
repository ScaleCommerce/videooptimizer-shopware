# Run from a Shopware project that has the plugin in custom/plugins (see .github/workflows/ci.yml).
parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Resources
    treatPhpDocTypesAsCertain: false
    # The storefront bundle is not a requirement of the plugin (it only needs shopware/core); the
    # page subscribers react to its events when it is installed.
    ignoreErrors:
        -
            identifier: class.notFound
            path: src/Subscriber/ProductVideoSubscriber.php
        -
            identifier: class.notFound
            path: src/Subscriber/VideoDetailMetaSubscriber.php
