{% block scalecommerce_vo_video_picker %}
<div class="scalecommerce-vo-video-picker">
    <mt-select
        :label="$tc('scalecommerce-vo.list.selectLibrary')"
        :options="libraryOptions"
        :model-value="libraryId"
        @update:model-value="onLibraryChange" />
    <mt-select
        :label="$tc('scalecommerce-vo.list.videosTitle')"
        :options="videoOptions"
        :model-value="videoUuid"
        @update:model-value="onVideoChange" />

    <div v-if="libraryId" class="scalecommerce-vo-video-picker__upload" style="margin-top:12px">
        <mt-text-field
            :label="$tc('scalecommerce-vo.cms.uploadNew')"
            :placeholder="$tc('scalecommerce-vo.list.videoTitle')"
            v-model="uploadTitle" />
        <input type="file" accept="video/*" :disabled="isUploading" @change="onFileSelected" />
        <mt-button
            variant="secondary"
            size="small"
            :is-loading="isUploading"
            :disabled="!uploadFile || isUploading"
            @click="onUpload">
            {{ $tc('scalecommerce-vo.list.upload') }}
        </mt-button>
    </div>
</div>
{% endblock %}
