{% block element_scalecommerce_vo_media_split %}
<div class="scalecommerce-vo-media-split-component">
    <template v-if="video">
        <div class="scalecommerce-vo-media-split-component__poster">
            <img v-if="posterUrl" :src="posterUrl" :alt="headline" />
            <mt-icon v-else name="regular-play" size="40" />
        </div>
        <div class="scalecommerce-vo-media-split-component__meta">
            <span class="scalecommerce-vo-media-split-component__title">{{ headline }}</span>
            <sw-label :variant="statusVariant(video.status)" size="small" :ghost="true">{{ video.status }}</sw-label>
        </div>
        <span v-if="metaLine()" class="scalecommerce-vo-media-split-component__meta-info">{{ metaLine() }}</span>
    </template>
    <div v-else class="scalecommerce-vo-media-split-component__empty">
        <mt-icon name="regular-play" size="32" />
        <span>{{ $tc('scalecommerce-vo.cms.selectVideo') }}</span>
    </div>
</div>
{% endblock %}
