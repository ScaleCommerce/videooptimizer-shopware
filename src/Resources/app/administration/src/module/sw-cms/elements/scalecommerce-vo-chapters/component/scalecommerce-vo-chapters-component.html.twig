{% block element_scalecommerce_vo_chapters %}
<div class="scalecommerce-vo-chapters-component">
    <p v-if="headline" class="scalecommerce-vo-chapters-component__headline">{{ headline }}</p>
    <scalecommerce-vo-preview-surface
        :aspect="formatAspect"
        :poster-url="posterUrl"
        presentation="direct"
        :player-mode="playerMode"
        :controls="showControls"
        :status="video ? video.status : null"
        :meta="metaLine()"
        :has-video="!!video"
        :missing="videoMissing"
        :tooltip="video ? (video.title || video.uuid) : null"
    />
    <ol class="scalecommerce-vo-chapters-component__scenes" aria-hidden="true">
        <li v-for="scene in scenes" :key="scene.index" class="scalecommerce-vo-chapters-component__scene">
            <span class="scalecommerce-vo-chapters-component__thumb"></span>
            <span class="scalecommerce-vo-chapters-component__label">{{ scene.label }}</span>
        </li>
    </ol>
</div>
{% endblock %}
