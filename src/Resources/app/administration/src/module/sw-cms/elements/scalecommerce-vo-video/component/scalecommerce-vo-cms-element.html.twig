{% block element_scalecommerce_vo_video %}
<div class="scalecommerce-vo-cms-element" style="display:flex;align-items:center;justify-content:center;min-height:120px;background:#f0f2f5;border-radius:4px">
    <template v-if="videoUuid">
        <mt-icon name="regular-play-circle" size="32" />
        <span style="margin-left:8px">{{ videoUuid }}</span>
    </template>
    <span v-else>{{ $tc('scalecommerce-vo.cms.selectVideo') }}</span>
</div>
{% endblock %}
