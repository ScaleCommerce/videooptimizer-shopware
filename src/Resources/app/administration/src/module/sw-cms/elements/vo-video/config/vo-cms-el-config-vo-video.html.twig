{% block element_config_vo_video %}
<div class="vo-cms-el-config-vo-video">
    <vo-video-picker :value="pickerValue" @update:value="onPickerChange" />

    <mt-switch :label="$tc('vo-media.cms.showControls')" v-model="element.config.showControls.value" />
    <mt-switch :label="$tc('vo-media.cms.autoplay')" v-model="element.config.autoplay.value" />
    <mt-switch :label="$tc('vo-media.cms.muted')" v-model="element.config.muted.value" />
    <mt-switch :label="$tc('vo-media.cms.loop')" v-model="element.config.loop.value" />
</div>
{% endblock %}
