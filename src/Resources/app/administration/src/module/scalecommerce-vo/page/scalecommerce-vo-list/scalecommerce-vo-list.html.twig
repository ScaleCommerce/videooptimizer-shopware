{% block scalecommerce_vo_list %}
<sw-page class="scalecommerce-vo-list">
    <template #content>
        <sw-card-view>
            <mt-card :title="$tc('scalecommerce-vo.list.librariesTitle')" position-identifier="scalecommerce-vo-libraries">
                <mt-select
                    :label="$tc('scalecommerce-vo.list.selectLibrary')"
                    :options="libraryOptions"
                    v-model="selectedLibraryId" />
                <div class="scalecommerce-vo-list__library-actions">
                    <mt-button variant="secondary" @click="onCreateLibrary(window.prompt($tc('scalecommerce-vo.list.newLibraryName')))">
                        {{ $tc('scalecommerce-vo.list.createLibrary') }}
                    </mt-button>
                    <mt-button v-if="selectedLibraryId" variant="critical" @click="onDeleteLibrary(selectedLibraryId)">
                        {{ $tc('scalecommerce-vo.list.deleteLibrary') }}
                    </mt-button>
                </div>
            </mt-card>

            <mt-card :title="$tc('scalecommerce-vo.list.videosTitle')" position-identifier="scalecommerce-vo-videos">
                <scalecommerce-vo-video-gallery :library-id="selectedLibraryId" mode="manage" />
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
