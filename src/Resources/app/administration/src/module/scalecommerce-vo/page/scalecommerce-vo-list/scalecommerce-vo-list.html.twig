{% block scalecommerce_vo_list %}
<sw-page class="scalecommerce-vo-list">

    {% block scalecommerce_vo_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('scalecommerce-vo.list.pageTitle') }}</h2>
    </template>
    {% endblock %}

    {% block scalecommerce_vo_list_smart_bar_actions %}
    <template #smart-bar-actions>
        <mt-button variant="secondary" @click="mode === 'create' ? onCancelCreate() : onNewLibrary()">
            {{ mode === 'create' ? $tc('scalecommerce-vo.library.cancel') : $tc('scalecommerce-vo.library.new') }}
        </mt-button>
        <mt-button variant="primary" :is-loading="isSaving" :disabled="!canSave" @click="onSave">
            {{ $tc('scalecommerce-vo.library.save') }}
        </mt-button>
    </template>
    {% endblock %}

    <template #content>
        <sw-card-view>

            {% block scalecommerce_vo_list_library_card %}
            <mt-card
                :title="$tc('scalecommerce-vo.library.title')"
                :subtitle="libraryMeta"
                position-identifier="scalecommerce-vo-libraries">

                <template v-if="mode !== 'create' && selectedLibraryId" #headerRight>
                    <sw-context-button>
                        <sw-context-menu-item :disabled="!mediaManaged || isReprocessing" @click="onReprocessLibraryClick">
                            {{ $tc('scalecommerce-vo.library.reprocess') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item variant="danger" @click="onDeleteLibraryClick">
                            {{ $tc('scalecommerce-vo.library.delete') }}
                        </sw-context-menu-item>
                    </sw-context-button>
                </template>

                <mt-select
                    :label="$tc('scalecommerce-vo.list.selectLibrary')"
                    :options="libraryOptions"
                    :model-value="selectedLibraryId"
                    :disabled="mode === 'create'"
                    @update:model-value="onSelectLibrary" />

                <mt-banner v-if="!mediaManaged" class="scalecommerce-vo-list__banner" variant="info">
                    {{ $tc('scalecommerce-vo.library.deliveryOnly') }}
                </mt-banner>

                <sw-modal
                    v-if="confirmDeleteLibrary"
                    variant="small"
                    :title="$t('scalecommerce-vo.library.confirmDeleteTitle')"
                    @modal-close="confirmDeleteLibrary = false">
                    <p>{{ $t('scalecommerce-vo.library.confirmDeleteText', { name: activeLibrary ? activeLibrary.name : '' }) }}</p>
                    <template #modal-footer>
                        <mt-button size="small" variant="secondary" @click="confirmDeleteLibrary = false">
                            {{ $tc('scalecommerce-vo.library.cancel') }}
                        </mt-button>
                        <mt-button size="small" variant="critical" @click="onConfirmDeleteLibrary">
                            {{ $tc('scalecommerce-vo.library.delete') }}
                        </mt-button>
                    </template>
                </sw-modal>

                <sw-modal
                    v-if="confirmReprocessLibrary"
                    variant="small"
                    :title="$t('scalecommerce-vo.library.reprocessConfirmTitle')"
                    @modal-close="confirmReprocessLibrary = false">
                    <p>{{ $t('scalecommerce-vo.library.reprocessConfirmText', { name: activeLibrary ? activeLibrary.name : '' }) }}</p>
                    <template #modal-footer>
                        <mt-button size="small" variant="secondary" @click="confirmReprocessLibrary = false">
                            {{ $tc('scalecommerce-vo.library.cancel') }}
                        </mt-button>
                        <mt-button size="small" variant="critical" @click="onConfirmReprocessLibrary">
                            {{ $tc('scalecommerce-vo.library.reprocess') }}
                        </mt-button>
                    </template>
                </sw-modal>
            </mt-card>
            {% endblock %}

            {% block scalecommerce_vo_list_basic_data_card %}
            <mt-card
                :title="$tc('scalecommerce-vo.library.basicDataTitle')"
                position-identifier="scalecommerce-vo-basic-data">
                <sw-container columns="1fr 1fr" gap="0 32px">
                    <mt-text-field :label="$tc('scalecommerce-vo.library.name')" v-model="formName" required />
                    <mt-textarea :label="$tc('scalecommerce-vo.library.description')" v-model="formDescription" />
                </sw-container>
            </mt-card>
            {% endblock %}

            {% block scalecommerce_vo_list_encoding_card %}
            <mt-card
                :title="$tc('scalecommerce-vo.library.encodingTitle')"
                position-identifier="scalecommerce-vo-encoding">
                <sw-container columns="1fr 1fr" gap="0 32px">
                    <div class="scalecommerce-vo-list__ladder-group">
                        <span class="scalecommerce-vo-list__ladder-label">{{ $tc('scalecommerce-vo.library.codecs') }}</span>
                        <div class="scalecommerce-vo-list__ladder-options">
                            <mt-checkbox
                                v-for="option in encodings.codecs"
                                :key="option.key"
                                :model-value="selectedCodecs.includes(option.key)"
                                :disabled="optionDisabled(option, 'codecs')"
                                @update:model-value="toggleCodec(option.key)">
                                <template #label>
                                    {{ optionLabel(option) }}
                                    <sw-label v-if="option.access === 'addon'" variant="info" size="small">
                                        {{ $tc('scalecommerce-vo.library.addon') }}
                                    </sw-label>
                                </template>
                            </mt-checkbox>
                        </div>
                    </div>

                    <div class="scalecommerce-vo-list__ladder-group">
                        <span class="scalecommerce-vo-list__ladder-label">{{ $tc('scalecommerce-vo.library.resolutions') }}</span>
                        <div class="scalecommerce-vo-list__ladder-options">
                            <mt-checkbox
                                v-for="option in encodings.resolutions"
                                :key="option.key"
                                :model-value="selectedResolutions.includes(option.key)"
                                :disabled="optionDisabled(option, 'resolutions')"
                                @update:model-value="toggleResolution(option.key)">
                                <template #label>
                                    {{ optionLabel(option) }}
                                    <sw-label v-if="option.access === 'addon'" variant="info" size="small">
                                        {{ $tc('scalecommerce-vo.library.addon') }}
                                    </sw-label>
                                </template>
                            </mt-checkbox>
                        </div>
                    </div>
                </sw-container>

                <mt-banner v-if="ladderChanged" class="scalecommerce-vo-list__banner" variant="attention">
                    {{ $tc('scalecommerce-vo.library.ladderChangedHint') }}
                </mt-banner>
            </mt-card>
            {% endblock %}

            {% block scalecommerce_vo_list_videos %}
            <scalecommerce-vo-video-gallery :library-id="galleryLibraryId" mode="manage" />
            {% endblock %}
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
