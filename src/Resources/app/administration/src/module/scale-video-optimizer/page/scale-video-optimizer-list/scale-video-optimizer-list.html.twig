{% block scale_video_optimizer_list %}
<sw-page class="scale-video-optimizer-list">
    <template #content>
        <sw-card-view>
            <mt-card :title="$tc('scale-video-optimizer.list.librariesTitle')" position-identifier="scale-video-optimizer-libraries">
                <mt-select
                    :label="$tc('scale-video-optimizer.list.selectLibrary')"
                    :options="libraryOptions"
                    v-model="selectedLibraryId"
                    @update:model-value="loadVideos" />
                <div class="scale-video-optimizer-list__library-actions">
                    <mt-button variant="secondary" @click="onCreateLibrary(window.prompt($tc('scale-video-optimizer.list.newLibraryName')))">
                        {{ $tc('scale-video-optimizer.list.createLibrary') }}
                    </mt-button>
                    <mt-button v-if="selectedLibraryId" variant="critical" @click="onDeleteLibrary(selectedLibraryId)">
                        {{ $tc('scale-video-optimizer.list.deleteLibrary') }}
                    </mt-button>
                </div>
            </mt-card>

            <mt-card :title="$tc('scale-video-optimizer.list.uploadTitle')" position-identifier="scale-video-optimizer-upload">
                <mt-text-field v-model="uploadTitle" :label="$tc('scale-video-optimizer.list.videoTitle')" />
                <input type="file" accept="video/*" @change="onFileSelected" />
                <mt-button variant="primary" :disabled="!uploadFile || !selectedLibraryId" @click="onUpload">
                    {{ $tc('scale-video-optimizer.list.upload') }}
                </mt-button>
            </mt-card>

            <mt-card :title="$tc('scale-video-optimizer.list.videosTitle')" position-identifier="scale-video-optimizer-videos" :is-loading="isLoading">
                <div class="scale-video-optimizer-list__grid">
                    <div v-for="video in videos" :key="video.uuid" class="scale-video-optimizer-list__item">
                        <img v-if="video.thumbnail_url" :src="video.thumbnail_url" :alt="video.title" />
                        <div class="scale-video-optimizer-list__meta">
                            <strong>{{ video.title }}</strong>
                            <span>{{ video.status }}</span>
                        </div>
                        <mt-button size="small" variant="secondary" @click="onRenameVideo(video.uuid, window.prompt($tc('scale-video-optimizer.list.rename'), video.title))">
                            {{ $tc('scale-video-optimizer.list.rename') }}
                        </mt-button>
                        <mt-button size="small" variant="critical" @click="onDeleteVideo(video.uuid)">
                            {{ $tc('scale-video-optimizer.list.delete') }}
                        </mt-button>
                    </div>
                </div>
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
