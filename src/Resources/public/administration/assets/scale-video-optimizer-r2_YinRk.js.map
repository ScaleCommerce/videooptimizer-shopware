{% block element_scalecommerce_vo_spotlight %}
<div class="scalecommerce-vo-spotlight-component">
    <p class="scalecommerce-vo-spotlight-component__eyebrow"
       :class="{ 'scvo-preview-placeholder': !eyebrow }">
        {{ eyebrow || $tc('scalecommerce-vo.cms.placeholder.eyebrow') }}
    </p>
    <p class="scalecommerce-vo-spotlight-component__headline"
       :class="{ 'scvo-preview-placeholder': !headline }">
        {{ headline || $tc('scalecommerce-vo.cms.placeholder.headline') }}
    </p>
    <scalecommerce-vo-preview-surface
        :poster-url="posterUrl"
        :presentation="presentation"
        :player-mode="playerMode"
        :controls="showControls"
        :status="video ? video.status : null"
        :meta="metaLine()"
        :has-video="!!video"
        :tooltip="video ? (video.title || video.uuid) : null"
    />
    <p class="scalecommerce-vo-spotlight-component__caption"
       :class="{ 'scvo-preview-placeholder': !caption }">
        {{ caption || $tc('scalecommerce-vo.cms.placeholder.caption') }}
    </p>
</div>
{% endblock %}
