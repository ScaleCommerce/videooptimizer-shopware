{% block element_scalecommerce_vo_background_hero %}
<div class="scalecommerce-vo-background-hero-component">
    <scalecommerce-vo-preview-surface
        :poster-url="posterUrl"
        presentation="background"
        :min-height="editorHeight"
        :status="video ? video.status : null"
        :meta="metaLine()"
        :has-video="!!video"
        :tooltip="video ? (video.title || video.uuid) : null"
    >
        <div class="scalecommerce-vo-background-hero-component__overlay" :class="'is-' + overlay"></div>
        <div class="scalecommerce-vo-background-hero-component__content" :style="contentStyle">
            <span class="scalecommerce-vo-background-hero-component__eyebrow"
                  :class="{ 'scvo-preview-placeholder': !eyebrow }">
                {{ eyebrow || $tc('scalecommerce-vo.cms.placeholder.eyebrow') }}
            </span>
            <p class="scalecommerce-vo-background-hero-component__headline"
               :class="{ 'scvo-preview-placeholder': !headline }">
                {{ headline || $tc('scalecommerce-vo.cms.placeholder.headline') }}
            </p>
            <p class="scalecommerce-vo-background-hero-component__subline"
               :class="{ 'scvo-preview-placeholder': !subline }">
                {{ subline || $tc('scalecommerce-vo.cms.placeholder.subline') }}
            </p>
            <span class="scvo-preview-cta"
                  :class="{ 'scvo-preview-placeholder': !ctaLabel }">
                {{ ctaLabel || $tc('scalecommerce-vo.cms.placeholder.cta') }}
            </span>
        </div>
    </scalecommerce-vo-preview-surface>
</div>
{% endblock %}
