{% block scalecommerce_vo_cms_block_preview %}
{# Schematic preview: a single video with a play button #}
<div class="scalecommerce-vo-cms-block-preview"
     style="display:flex;align-items:center;justify-content:center;height:100%;min-height:60px;background:#eef2fb;padding:8px">
    <svg viewBox="0 0 200 96" width="100%" style="max-width:100%;height:auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Single video">
        <rect x="18" y="14" width="164" height="68" rx="6" fill="#1d4ed8"/>
        <circle cx="100" cy="48" r="14" fill="#ffffff"/>
        <path d="M96 41 L96 55 L108 48 Z" fill="#1d4ed8"/>
    </svg>
</div>
{% endblock %}
