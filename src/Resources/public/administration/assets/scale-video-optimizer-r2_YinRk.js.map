{% block element_scalecommerce_vo_video %}
<div class="scalecommerce-vo-cms-element">
    <scalecommerce-vo-preview-surface
        :poster-url="posterUrl"
        presentation="direct"
        :player-mode="playerMode"
        :controls="showControls"
        :status="video ? video.status : null"
        :meta="metaLine()"
        :has-video="!!video"
        :tooltip="video ? (video.title || video.uuid) : null"
    />
</div>
{% endblock %}
