<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient">
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\Controller\VideoOptimizerAdminController" public="true">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\DataResolver\VideoOptimizerElementResolver">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\DataResolver\MediaSplitElementResolver">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
            <argument type="service" id="Shopware\Core\Framework\Util\HtmlSanitizer"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\DataResolver\BackgroundHeroElementResolver">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\DataResolver\SpotlightElementResolver">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="ScaleCommerce\VideoOptimizer\DataResolver\VideoGridElementResolver">
            <argument type="service" id="ScaleCommerce\VideoOptimizer\Service\VideoOptimizerClient"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>
    </services>
</container>
