{% import "@ScaleVideoOptimizer/storefront/element/_scalecommerce-vo-surface.html.twig" as vo %}
{% block element_scalecommerce_vo_chapters %}
    {% set data = element.data %}
    {% set config = element.config %}
    {% set surfaceOptions = {
        controls: config.showControls.value ?? true,
        autoplay: config.autoplay.value ?? false,
        muted: config.muted.value ?? false,
        loop: config.loop.value ?? false,
        posterSizes: '(min-width: 1280px) 1280px, 100vw',
        layout: data.layout ?? {}
    } %}
    {% if data and data.videoUuid and not data.hasError and (data.playerMode == 'embed' or data.embed) %}
        <div class="scalecommerce-vo-chapters" data-scalecommerce-vo-chapters="true">
            {% block element_scalecommerce_vo_chapters_headline %}
                {% if data.headline %}<h2 class="scalecommerce-vo-chapters__headline">{{ data.headline }}</h2>{% endif %}
            {% endblock %}
            {% block element_scalecommerce_vo_chapters_player %}
                {# Floating mini player: the player area stays in the flow as the placeholder (scalecommerce-vo-mini plugin). #}
                <div class="scalecommerce-vo-chapters__player"{% if data.layout.mini ?? false %} data-scalecommerce-vo-mini="true" data-vo-label-close="{{ 'scalecommerce-vo.storefront.close'|trans }}"{% endif %}>
                    {{ vo.surface(data.embed, 'direct', data.playerMode, data.embedUrl, data.headline, surfaceOptions) }}
                </div>
            {% endblock %}
            {% block element_scalecommerce_vo_chapters_scenes %}
                {% if data.scenes|length > 0 %}
                    <ol class="scalecommerce-vo-scenes" aria-label="{{ 'scalecommerce-vo.storefront.scenes'|trans }}">
                        {% for scene in data.scenes %}
                            {% set label = scene.title ?: ('scalecommerce-vo.storefront.scene'|trans({'%number%': loop.index})) %}
                            <li class="scalecommerce-vo-scenes__item">
                                <button type="button" class="scalecommerce-vo-scene" data-vo-scene="{{ scene.start }}"
                                        aria-label="{{ 'scalecommerce-vo.storefront.sceneAria'|trans({'%label%': label, '%time%': scene.time}) }}">
                                    <span class="scalecommerce-vo-scene__thumb">
                                        <img src="{{ scene.thumb }}" alt="" width="320" height="180" loading="lazy" decoding="async">
                                        <span class="scalecommerce-vo-scene__time">{{ scene.time }}</span>
                                    </span>
                                    <span class="scalecommerce-vo-scene__label">{{ label }}</span>
                                </button>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
