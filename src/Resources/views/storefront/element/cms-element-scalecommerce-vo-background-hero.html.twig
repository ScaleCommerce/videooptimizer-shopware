{% block element_scalecommerce_vo_background_hero %}
    {% set data = element.data %}
    {% if data and data.videoUuid %}
        {% set embed = data.embed %}
        <section class="scalecommerce-vo-hero scalecommerce-vo-hero--{{ data.height }} scalecommerce-vo-hero--overlay-{{ data.overlay }}"
                 style="{% if data.headlineColor %}--scvo-hero-heading:{{ data.headlineColor }};{% endif %}{% if data.textColor %}--scvo-hero-text:{{ data.textColor }};{% endif %}">
            <video class="scalecommerce-vo-hero__video" muted autoplay loop playsinline
                   preload="{{ data.priority ? 'auto' : 'metadata' }}"
                   {% if embed and embed.poster %}poster="{{ embed.poster }}"{% endif %}
                   {% if embed and embed.hls %}data-scalecommerce-vo-hero-hls="{{ embed.hls }}"{% elseif embed and embed.mp4 %}src="{{ embed.mp4 }}"{% endif %}></video>
            <div class="scalecommerce-vo-hero__overlay"></div>
            <div class="scalecommerce-vo-hero__content">
                {% if data.eyebrow %}<span class="scalecommerce-vo-hero__eyebrow">{{ data.eyebrow }}</span>{% endif %}
                {% if data.headline %}<h2 class="scalecommerce-vo-hero__headline">{{ data.headline }}</h2>{% endif %}
                {% if data.subline %}<p class="scalecommerce-vo-hero__subline">{{ data.subline|nl2br }}</p>{% endif %}
                {% if data.ctaLabel and data.ctaUrl %}
                    <a class="btn btn-primary scalecommerce-vo-hero__cta" href="{{ data.ctaUrl }}">{{ data.ctaLabel }}</a>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}
