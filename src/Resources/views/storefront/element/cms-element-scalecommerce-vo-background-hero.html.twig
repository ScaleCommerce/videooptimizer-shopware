{% block element_scalecommerce_vo_background_hero %}
    {% set data = element.data %}
    {% if data and data.videoUuid %}
        {% set embed = data.embed %}
        <section class="scalecommerce-vo-hero scalecommerce-vo-hero--{{ data.height }} scalecommerce-vo-hero--overlay-{{ data.overlay }}"
                 style="{% if data.headlineColor %}--scvo-hero-heading:{{ data.headlineColor }};{% endif %}{% if data.textColor %}--scvo-hero-text:{{ data.textColor }};{% endif %}">
            {% if embed.jsonLd ?? null %}<script type="application/ld+json">{{ embed.jsonLd|raw }}</script>{% endif %}
            {% if embed and (embed.hls or embed.mp4 or embed.poster) %}
                {% set responsivePoster = embed.poster and embed.posterSrcsetAttr %}
                {% if responsivePoster %}
                    {# The poster is an <img> with srcset, so small screens do not load the large poster; a priority
                       hero (above the fold) loads it with high fetch priority and gives the video the same poster
                       URL (cache hit), so the poster shows when autoplay is blocked. #}
                    <img class="scalecommerce-vo-hero__poster" src="{{ embed.poster }}" srcset="{{ embed.posterSrcsetAttr }}" sizes="100vw" alt=""
                         decoding="async"{% if data.priority %} fetchpriority="high"{% endif %}>
                {% endif %}
                {# No autoplay attribute: the hero plugin starts playback only when the hero is visible and
                   motion is not reduced (prefers-reduced-motion, data saver). #}
                <video class="scalecommerce-vo-hero__video" muted loop playsinline aria-hidden="true"
                       preload="{{ data.priority ? 'auto' : 'metadata' }}"
                       data-scalecommerce-vo-hero="true"
                       {% if data.priority %}data-scalecommerce-vo-hero-priority="true"{% endif %}
                       {% if embed.poster and (not responsivePoster or data.priority) %}poster="{{ embed.poster }}"{% endif %}
                       {% if embed.hls %}data-scalecommerce-vo-hero-hls="{{ embed.hls }}"{% endif %}
                       {% if embed.mp4 %}data-scalecommerce-vo-hero-mp4="{{ embed.mp4 }}"{% endif %}></video>
                {% if embed.hls or embed.mp4 %}
                    <button type="button" class="scalecommerce-vo-hero__toggle" hidden
                            data-label-pause="{{ 'scalecommerce-vo.storefront.heroPause'|trans }}"
                            data-label-play="{{ 'scalecommerce-vo.storefront.heroPlay'|trans }}"
                            aria-label="{{ 'scalecommerce-vo.storefront.heroPlay'|trans }}">
                        <span class="scalecommerce-vo-hero__toggle-icon" aria-hidden="true"></span>
                    </button>
                {% endif %}
            {% endif %}
            <div class="scalecommerce-vo-hero__overlay"></div>
            <div class="scalecommerce-vo-hero__content">
                {% if data.eyebrow %}<span class="scalecommerce-vo-hero__eyebrow">{{ data.eyebrow }}</span>{% endif %}
                {% if data.headline %}<h2 class="scalecommerce-vo-hero__headline">{{ data.headline }}</h2>{% endif %}
                {% if data.subline %}<p class="scalecommerce-vo-hero__subline">{{ data.subline|nl2br }}</p>{% endif %}
                {% if data.ctaLabel and data.ctaUrl %}
                    <a class="btn btn-primary scalecommerce-vo-hero__cta" href="{{ data.ctaUrl }}">{{ data.ctaLabel }}</a>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}
