{% block element_scalecommerce_vo_video %}
    {% set videoData = element.data %}
    {% set config = element.config %}
    {% if videoData and videoData.videoUuid and not videoData.hasError %}
        {% if videoData.playerMode == 'embed' %}
            <div class="cms-element-scalecommerce-vo-video" style="width:100%">
                <div class="scalecommerce-vo-video" style="position:relative;width:100%;aspect-ratio:16 / 9">
                    <iframe src="{{ videoData.embedUrl }}"
                            allow="autoplay; fullscreen"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            sandbox="allow-scripts allow-same-origin allow-popups allow-presentation"
                            style="position:absolute;inset:0;width:100%;height:100%;border:0"></iframe>
                </div>
            </div>
        {% elseif videoData.embed and not videoData.hasError %}
            {% set aspectRatio = (videoData.embed.aspectRatio ?? null)|default('16 / 9') %}
            <div class="cms-element-scalecommerce-vo-video" style="width:100%">
                <div class="scalecommerce-vo-video"
                     data-scalecommerce-vo-player="true"
                     data-scalecommerce-vo-player-options='{{ {
                         hls: videoData.embed.hls ?? null,
                         mp4: videoData.embed.mp4 ?? null,
                         poster: videoData.embed.poster ?? null,
                         controls: config.showControls.value ?? true,
                         autoplay: config.autoplay.value ?? false,
                         muted: config.muted.value ?? false,
                         loop: config.loop.value ?? false
                     }|json_encode }}'
                     style="position:relative;width:100%;aspect-ratio:{{ aspectRatio }}">
                    <video class="scalecommerce-vo-video__player"
                           style="width:100%;height:100%;object-fit:cover"
                           playsinline
                           {% if videoData.embed.poster %}poster="{{ videoData.embed.poster }}"{% endif %}></video>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
