{% block element_scalecommerce_vo_video %}
    {% set videoData = element.data %}
    {% set config = element.config %}
    {% if videoData and videoData.videoUuid and not videoData.hasError %}
        {% if videoData.playerMode == 'embed' %}
            <div class="cms-element-scalecommerce-vo-video">
                <div class="scalecommerce-vo-video scalecommerce-vo-video--sized">
                    <iframe src="{{ videoData.embedUrl }}"
                            title="{{ (videoData.embed.title ?? null) ?: ('scalecommerce-vo.storefront.video'|trans) }}"
                            allow="autoplay; fullscreen; picture-in-picture" allowfullscreen
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            sandbox="allow-scripts allow-same-origin allow-popups allow-presentation"
                            class="scalecommerce-vo-frame"></iframe>
                </div>
            </div>
        {% elseif videoData.embed and not videoData.hasError %}
            {% set aspectRatio = (videoData.embed.aspectRatio ?? null)|default('16 / 9') %}
            <div class="cms-element-scalecommerce-vo-video">
                <div class="scalecommerce-vo-video scalecommerce-vo-video--sized"
                     data-scalecommerce-vo-player="true"
                     data-scalecommerce-vo-player-options='{{ {
                         hls: videoData.embed.hls ?? null,
                         mp4: videoData.embed.mp4 ?? null,
                         poster: videoData.embed.poster ?? null,
                         controls: config.showControls.value ?? true,
                         autoplay: config.autoplay.value ?? false,
                         muted: config.muted.value ?? false,
                         loop: config.loop.value ?? false,
                         theme: videoData.embed.theme ?? {},
                         tracks: videoData.embed.tracks ?? [],
                         unavailableLabel: 'scalecommerce-vo.storefront.unavailable'|trans
                     }|json_encode }}'
                     style="--scvo-aspect: {{ aspectRatio }}{% if videoData.embed.theme.accentColor ?? null %}; --vo-accent: {{ videoData.embed.theme.accentColor }}{% endif %}">
                    <video class="scalecommerce-vo-video__player"
                           playsinline
                           {% if videoData.embed.tracks %}crossorigin="anonymous"{% endif %}
                           {% if videoData.embed.poster %}poster="{{ videoData.embed.poster }}"{% endif %}>
                        {% for track in videoData.embed.tracks ?? [] %}<track kind="{{ track.kind }}" srclang="{{ track.srclang }}" label="{{ track.label }}" src="{{ track.src }}"{% if track.default %} default{% endif %}>{% endfor %}
                    </video>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
