{% macro surface(embed, presentation, playerMode, embedUrl, label, options) %}
    {% set aspect = (embed.aspectRatio ?? null)|default('16 / 9') %}
    {% set opts = options|default({}) %}
    {% set videoTitle = label ?: (embed.title ?? null) ?: ('scalecommerce-vo.storefront.video'|trans) %}
    {% set nativeOptions = {
        hls: embed.hls ?? null,
        mp4: embed.mp4 ?? null,
        poster: embed.poster ?? null,
        controls: opts.controls ?? true,
        autoplay: opts.autoplay ?? false,
        muted: opts.muted ?? false,
        loop: opts.loop ?? false,
        unavailableLabel: 'scalecommerce-vo.storefront.unavailable'|trans
    } %}
    <div class="scalecommerce-vo-surface" style="--scvo-aspect: {{ aspect }}"
         data-scalecommerce-vo-block="true"
         data-vo-presentation="{{ presentation }}"
         data-vo-player-mode="{{ playerMode }}"
         data-vo-embed-url="{{ embedUrl }}"
         data-vo-title="{{ videoTitle }}"
         data-vo-native-options='{{ nativeOptions|json_encode }}'
         data-vo-label-close="{{ 'scalecommerce-vo.storefront.close'|trans }}">
        {% if presentation == 'direct' %}
            {% if playerMode == 'embed' %}
                <iframe src="{{ embedUrl }}" title="{{ videoTitle }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
                        sandbox="allow-scripts allow-same-origin allow-popups allow-presentation"
                        class="scalecommerce-vo-frame"></iframe>
            {% else %}
                <div class="scalecommerce-vo-video scalecommerce-vo-fill" data-scalecommerce-vo-player="true"
                     data-scalecommerce-vo-player-options='{{ nativeOptions|json_encode }}'>
                    <video class="scalecommerce-vo-video__player" playsinline
                           {% if embed.poster %}poster="{{ embed.poster }}"{% endif %}></video>
                </div>
            {% endif %}
        {% else %}
            <button type="button" class="scalecommerce-vo-surface__facade"
                    data-vo-action="{{ presentation == 'lightbox' ? 'lightbox' : 'facade' }}"
                    aria-label="{{ label|default('scalecommerce-vo.storefront.play'|trans) }}">
                {% if embed.poster %}<img class="scalecommerce-vo-surface__poster" src="{{ embed.poster }}" alt="" loading="lazy">{% endif %}
                <span class="scalecommerce-vo-surface__play" aria-hidden="true">▶</span>
            </button>
        {% endif %}
    </div>
{% endmacro %}
