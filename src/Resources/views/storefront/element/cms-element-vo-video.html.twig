{% block element_vo_video %}
    {% set videoData = element.data %}
    {% set config = element.config %}
    {% set aspectRatio = config.aspectRatio.value|default('16/9') %}
    <div class="cms-element-vo-video" style="width:100%">
        {% if videoData and videoData.embed and not videoData.hasError %}
            {% set sources = videoData.embed.sources|default({}) %}
            <div class="vo-video"
                 data-vo-video-player="true"
                 data-vo-video-player-options='{{ {
                     hls: sources.hls|default(null),
                     mp4: sources.mp4|default(null),
                     webm: sources.webm|default(null),
                     poster: videoData.embed.poster|default(null),
                     controls: config.showControls.value|default(true),
                     autoplay: config.autoplay.value|default(false),
                     muted: config.muted.value|default(false),
                     loop: config.loop.value|default(false)
                 }|json_encode }}'
                 style="position:relative;width:100%;aspect-ratio:{{ aspectRatio }}">
                <video class="vo-video__player"
                       style="width:100%;height:100%;object-fit:cover"
                       playsinline
                       {% if videoData.embed.poster is defined %}poster="{{ videoData.embed.poster }}"{% endif %}></video>
            </div>
        {% else %}
            <div class="vo-video vo-video--empty">
                {{ "videoOptimizer.storefront.unavailable"|trans|default('Video is not available.') }}
            </div>
        {% endif %}
    </div>
{% endblock %}
